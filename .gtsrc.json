{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "*.js",
    "*.jsx",
    "*.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}