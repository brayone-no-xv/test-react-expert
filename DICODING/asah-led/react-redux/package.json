{
  "name": "react-redux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React Redux project following Google JavaScript Style Guide (gts) as per Dicoding requirements",
  "keywords": [
    "react",
    "redux",
    "google-style-guide",
    "gts",
    "dicoding"
  ],
  "styleguide": "Google JavaScript Style Guide (https://google.github.io/styleguide/jsguide.html)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
